{
  // اسم ثابت للووركر = رابط ثابت واحد (scholariq-center.<حسابك>.workers.dev) — كل نشر
  // بيروح لنفس الرابط بدل ما يتعمل رابط جديد بالغلط زي الـ٣ روابط القديمة.
  "name": "scholariq-center",
  // نيترو (بلجن الـTanStack Start الخاص بـCloudflare) بيولّد wrangler.json تلقائي
  // عند كل bun run build، وبيحط compatibility_date = تاريخ جهازك وقت البناء. لو
  // ساعة/تاريخ الجهاز غلط أو قدّام الحقيقي، Cloudflare بيرفض النشر برسالة
  // "Can't set compatibility date in the future". الملف ده بيثبّت تاريخ ماضي
  // آمن ومعروف عند Cloudflare بدل ما يعتمد على ساعة الجهاز — نيترو بيدمجه مع
  // الإعدادات المولّدة تلقائياً (اسم الووركر، الـassets، إلخ) من غير ما يمسحها.
  "compatibility_date": "2024-09-23",
  // مطلوب صراحة في DEPLOYMENT_SPEC.md §2 — supabase-js وبقية مكتبات Node
  // محتاجة نسخة Node compat من Cloudflare عشان تشتغل جوه الـWorker، وهو نفسه
  // اللي بيخلي process.env يشوف الأسرار (secrets) اللي بتتسجّل بـwrangler secret put.
  "compatibility_flags": ["nodejs_compat"],
}
